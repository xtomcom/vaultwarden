# Vaultwarden configuration.
# All options: https://github.com/dani-garcia/vaultwarden/blob/main/.env.template
# Apply changes with: systemctl restart vaultwarden

ROCKET_ADDRESS=127.0.0.1
ROCKET_PORT=8000

DATA_FOLDER=/var/lib/vaultwarden
WEB_VAULT_FOLDER=/usr/share/vaultwarden/web-vault
WEB_VAULT_ENABLED=true

## Public URL behind your reverse proxy (required for WebAuthn, attachments, emails)
# DOMAIN=https://vault.example.com

## Admin panel at /admin, generate a hash with: vaultwarden hash
# ADMIN_TOKEN=

# SIGNUPS_ALLOWED=false

## Use MySQL/MariaDB or PostgreSQL instead of SQLite
# DATABASE_URL=postgresql://user:password@localhost/vaultwarden
# DATABASE_URL=mysql://user:password@localhost/vaultwarden
